---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryOptions = [...new Map(
  games.flatMap((game) => game.category ? [[game.category.id, game.category] as const] : []),
).values()].sort((first, second) => first.name.localeCompare(second.name));
const publisherOptions = [...new Map(
  games.flatMap((game) => game.publisher ? [[game.publisher.id, game.publisher] as const] : []),
).values()].sort((first, second) => first.name.localeCompare(second.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      {games.length > 0 && (
        <section
          aria-labelledby="game-filters-heading"
          class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
          data-testid="game-filters"
        >
          <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 id="game-filters-heading" class="text-xl font-semibold text-slate-100">Find a game</h2>
              <p class="mt-1 text-sm text-slate-300">Filter by one or more categories and a publisher.</p>
            </div>
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
              data-testid="clear-game-filters"
            >
              Clear filters
            </button>
          </div>

          <div class="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(12rem,1fr)]">
            <fieldset>
              <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categoryOptions.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${category.id}`}
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publisherOptions.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
          </div>

          <p class="mt-5 text-sm text-slate-300" role="status" aria-live="polite" aria-atomic="true" data-testid="filter-results-count">
            Showing {games.length} of {games.length} games
          </p>
        </section>
      )}

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="mt-6 rounded-xl border border-slate-700 bg-slate-800/50 p-8 text-center text-slate-300" hidden data-testid="filter-empty-state">
            No games match your filters. Try changing or clearing your selections.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  if (filters && grid && emptyState) {
    const categoryInputs = Array.from(filters.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherSelect = filters.querySelector<HTMLSelectElement>('[name="publisher"]');
    const clearButton = filters.querySelector<HTMLButtonElement>('[data-testid="clear-game-filters"]');
    const resultCount = filters.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    if (!publisherSelect || !clearButton || !resultCount) {
      throw new Error('The game filters are missing required controls.');
    }

    const updateResults = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherSelect.value;
      let visibleCount = 0;

      for (const card of cards) {
        const matchesCategory =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategoryId ?? '');
        const matchesPublisher =
          selectedPublisher === '' || selectedPublisher === card.dataset.gamePublisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleCount += 1;
        }
      }

      resultCount.textContent = `Showing ${visibleCount} of ${cards.length} games`;
      emptyState.hidden = visibleCount > 0;
      clearButton.disabled = selectedCategories.size === 0 && selectedPublisher === '';
    };

    filters.addEventListener('change', updateResults);
    clearButton.addEventListener('click', () => {
      for (const input of categoryInputs) {
        input.checked = false;
      }
      publisherSelect.value = '';
      updateResults();
    });

    updateResults();
  }
</script>
